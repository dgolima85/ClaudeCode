DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Opcional. Só necessária se DATABASE_URL for uma conexão "pooled" (PgBouncer,
# Neon com -pooler no host, etc.) — nesse caso, aponte DIRECT_URL para a
# connection string DIRETA (sem pooler) do mesmo banco. O `prisma migrate
# deploy` usa essa variável (com fallback para DATABASE_URL se não definida),
# pois advisory locks não funcionam de forma confiável atrás de um pooler de
# transação e podem travar deploys (erro "Timed out trying to acquire a
# postgres advisory lock").
# DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Obrigatória: o Auth.js (usado para o login com Microsoft Entra ID) exige essa
# chave para assinar/criptografar a sessão, mesmo se você não for usar o
# Entra ID ainda — sem ela toda a aplicação quebra (inclusive o login manual
# por lista de analistas). Gere com: npx auth secret (ou: openssl rand -base64 33)
AUTH_SECRET=""

# Login com Microsoft Entra ID (Azure AD) — opcional: sem essas duas variáveis
# o botão "Entrar com Microsoft" aparece na tela de login mas falha; a lista
# de analistas continua funcionando normalmente. Veja o README para o passo a
# passo completo (o que pedir ao Administrador do Azure, Redirect URI, etc).
# App Registration do tipo cliente público (SPA) — autentica só com PKCE,
# não tem nem precisa de client secret.
# AUTH_MICROSOFT_ENTRA_ID_ID="<Application (client) ID>"
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0"
