// Sistema de Passagem de Turno — NOC/VOC
// Turno e Status são String (não enum do schema) para manter os mesmos
// valores/validação usados no app, ver src/lib/turno.ts e src/lib/status.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Analista {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  turno     String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ocorrencias Ocorrencia[] @relation("OcorrenciaAnalista")
  eventos     Evento[]
  avisos      Aviso[]

  passagensTurnoEntregues PassagemTurno[] @relation("PassagemTurnoEntrega")
  passagensTurnoRecebidas PassagemTurno[] @relation("PassagemTurnoRecebe")

  @@map("analistas")
}

// Painel de avisos da Home. "Status" (Ativo/Concluído) não é armazenado —
// é sempre calculado comparando expiraEm com o horário atual (ver
// src/lib/aviso.ts). Um aviso some do painel assim que expira.
model Aviso {
  id         String   @id @default(cuid())
  modelo     String
  descricao  String
  expiraEm   DateTime
  analistaId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  analista Analista @relation(fields: [analistaId], references: [id], onDelete: Restrict)

  @@index([expiraEm])
  @@map("avisos")
}

model TipoOcorrencia {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("tipos_ocorrencia")
}

model Parceria {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  empresas    Empresa[]
  ocorrencias Ocorrencia[]

  @@map("parcerias")
}

model Empresa {
  id          String       @id @default(cuid())
  nome        String
  parceriaId  String
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parceria    Parceria     @relation(fields: [parceriaId], references: [id], onDelete: Restrict)
  ocorrencias Ocorrencia[]

  @@unique([parceriaId, nome])
  @@map("empresas")
}

model Ambiente {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("ambientes")
}

model Servico {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("servicos")
}

model SistemaOperacional {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("sistemas_operacionais")
}

// Exibido na UI como "Ambiente" (substitui o antigo model Ambiente nas
// Ocorrências). Opções como AWS / Data Center Lapa / Data Center Campinas;
// cada uma tem sua própria lista de Recursos, no mesmo esquema de
// Parceria -> Empresa.
model AmbienteInfra {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  recursos    Recurso[]
  ocorrencias Ocorrencia[]

  @@map("ambientes_infra")
}

model Recurso {
  id              String        @id @default(cuid())
  nome            String
  ambienteInfraId String
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ambienteInfra   AmbienteInfra @relation(fields: [ambienteInfraId], references: [id], onDelete: Restrict)
  ocorrencias     Ocorrencia[]

  @@unique([ambienteInfraId, nome])
  @@map("recursos")
}

model Cdn {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("cdns")
}

model Plataforma {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("plataformas")
}

model Canal {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("canais")
}

model Causa {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("causas")
}

model Solucao {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ocorrencias Ocorrencia[]

  @@map("solucoes")
}

model Ocorrencia {
  id                    String    @id @default(cuid())
  tipoId                String
  status                String    @default("EM_ANDAMENTO")
  // ALTA / MEDIA / BAIXA (ver src/lib/criticidade.ts). Obrigatória na
  // criação para ocorrências novas; nula em ocorrências antigas até serem
  // preenchidas (é exigida antes de marcar como Resolvido).
  criticidade           String?
  titulo                String
  ticket                String?
  analistaId            String
  ambienteId            String?
  ambienteInfraId       String?
  cdnId                 String?
  resolvidoEm           DateTime?
  causaId               String?
  causaOutraDescricao   String?
  solucaoId             String?
  solucaoOutraDescricao String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tipo          TipoOcorrencia @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  analista      Analista       @relation("OcorrenciaAnalista", fields: [analistaId], references: [id], onDelete: Restrict)
  ambiente      Ambiente?      @relation(fields: [ambienteId], references: [id], onDelete: Restrict)
  ambienteInfra AmbienteInfra? @relation(fields: [ambienteInfraId], references: [id], onDelete: Restrict)
  cdn           Cdn?           @relation(fields: [cdnId], references: [id], onDelete: Restrict)
  causa         Causa?         @relation(fields: [causaId], references: [id], onDelete: Restrict)
  solucao       Solucao?       @relation(fields: [solucaoId], references: [id], onDelete: Restrict)
  eventos       Evento[]

  parcerias            Parceria[]
  empresas             Empresa[]
  servicos             Servico[]
  sistemasOperacionais SistemaOperacional[]
  recursos             Recurso[]
  plataformas          Plataforma[]
  canais               Canal[]
  passagensTurno       PassagemTurno[]

  @@index([status])
  @@index([createdAt])
  @@map("ocorrencias")
}

model Evento {
  id           String   @id @default(cuid())
  ocorrenciaId String
  analistaId   String
  comentario   String
  createdAt    DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  analista   Analista   @relation(fields: [analistaId], references: [id], onDelete: Restrict)

  @@index([ocorrenciaId])
  @@map("eventos")
}

// Fluxo ativo de passagem de turno: quem está saindo registra as ocorrências
// em aberto no momento e observações; quem assume o turno seguinte precisa
// confirmar o recebimento. Diferente do relatório em /relatorios/passagem-turno
// (que é só leitura, calculado on-the-fly), aqui fica um registro permanente
// e imutável após confirmado — serve de auditoria de que a troca realmente
// aconteceu. Turno/ocorrências ficam "congelados" no momento da criação.
model PassagemTurno {
  id                String    @id @default(cuid())
  turnoOrigem       String
  turnoDestino      String
  status            String    @default("ABERTA")
  observacoes       String?
  analistaEntregaId String
  analistaRecebeId  String?
  createdAt         DateTime  @default(now())
  confirmadaEm      DateTime?

  analistaEntrega Analista     @relation("PassagemTurnoEntrega", fields: [analistaEntregaId], references: [id], onDelete: Restrict)
  analistaRecebe  Analista?    @relation("PassagemTurnoRecebe", fields: [analistaRecebeId], references: [id], onDelete: Restrict)
  ocorrencias     Ocorrencia[]

  @@index([status])
  @@index([createdAt])
  @@map("passagens_turno")
}
